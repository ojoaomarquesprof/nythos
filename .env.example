# ============================================================
# Nythos — Example Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / App URL ────────────────────────────────────────────
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=
# Server-only HMAC secret for the patient portal cookie.
# Required in production. Use a long random value. Example: openssl rand -base64 32
PATIENT_SESSION_SECRET=

# ── Google Calendar OAuth 2.0 ─────────────────────────────────
# Create at: https://console.cloud.google.com → Credentials → OAuth 2.0 Client
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only HMAC secret for Google Calendar OAuth state/CSRF protection.
# Use a long random value. Example: openssl rand -base64 32
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# ── Clinical Encryption (server-side only) ────────────────────
# Clinical encryption keys must stay in Supabase Vault (nythos_encryption_key).
# Do not expose clinical encryption secrets via NEXT_PUBLIC_* variables.

# ── PWA Push Notifications (VAPID) ───────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Asaas Payment Gateway ─────────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Admin Script Credentials ──────────────────────────────────
# Only needed when running: npm run setup:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
