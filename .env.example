# ============================================================
# Nythos - Example Environment Variables
# Copy this file to .env.local and fill in the real values.
#
# Never commit .env.local or production secrets.
# Values below are placeholders only; they are not real secrets.
# ============================================================

# ------------------------------------------------------------
# Required for closed pilot / production
# ------------------------------------------------------------

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://example-project-ref.supabase.co

# Public Supabase anon key. Safe to expose, but RLS must stay enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Used only in trusted server contexts that manually verify authorization.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Public app URL used for redirects, patient links and OAuth callbacks.
# Production example: https://app.nythos.example
NEXT_PUBLIC_APP_URL=https://pilot.nythos.example

# Server-side HMAC secret for the patient portal cookie.
# Required in production. Use a long random value, for example:
# openssl rand -base64 32
PATIENT_SESSION_SECRET=replace-with-strong-random-32-byte-secret

# ------------------------------------------------------------
# Optional release metadata
# ------------------------------------------------------------

# Optional values exposed by /api/health.
NEXT_PUBLIC_APP_VERSION=pilot
NEXT_PUBLIC_BUILD_ID=local-build

# Vercel usually provides this automatically. Do not store a secret here.
VERCEL_GIT_COMMIT_SHA=

# ------------------------------------------------------------
# Optional Google Calendar integration
# ------------------------------------------------------------

# Required only if Google Calendar sync is enabled for the pilot.
# Authorized redirect URI:
# $NEXT_PUBLIC_APP_URL/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side HMAC secret for Google Calendar OAuth state/CSRF protection.
# Required only if Google Calendar sync is enabled. Minimum 32 characters.
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# ------------------------------------------------------------
# Optional PWA push notifications
# ------------------------------------------------------------

# NEXT_PUBLIC_VAPID_PUBLIC_KEY is browser-visible by design.
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:ops@example.com

# ------------------------------------------------------------
# Stripe SaaS billing - standby during closed pilot
# ------------------------------------------------------------

# Keep checkout disabled for the closed pilot unless deliberately testing
# Stripe in test mode. Live mode and sk_live keys are intentionally blocked
# by the application.
STRIPE_ENVIRONMENT=test
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Publishable key only. Never put Stripe secret keys in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Deprecated Asaas SaaS billing - standby during closed pilot
# ------------------------------------------------------------

# Kept for legacy references/tests. Do not enable checkout in the closed pilot.
# Never create NEXT_PUBLIC_ASAAS_* variables for secrets.
ASAAS_ENVIRONMENT=sandbox
ASAAS_CHECKOUT_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ------------------------------------------------------------
# Local/admin scripts only
# ------------------------------------------------------------

# Only needed when running: npm run setup:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-temporary-admin-password
