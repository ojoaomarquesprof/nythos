# ============================================================
# Nythos — Example Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / App URL ────────────────────────────────────────────
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=
# Server-only HMAC secret for the patient portal cookie.
# Required in production. Use a long random value. Example: openssl rand -base64 32
PATIENT_SESSION_SECRET=

# ── Google Calendar OAuth 2.0 ─────────────────────────────────
# Create at: https://console.cloud.google.com → Credentials → OAuth 2.0 Client
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/api/auth/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only HMAC secret for Google Calendar OAuth state/CSRF protection.
# Use a long random value. Example: openssl rand -base64 32
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# ── Clinical Encryption (server-side only) ────────────────────
# Clinical encryption keys must stay in Supabase Vault (nythos_encryption_key).
# Do not expose clinical encryption secrets via NEXT_PUBLIC_* variables.

# ── PWA Push Notifications (VAPID) ───────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# -- Stripe SaaS Billing (test mode only in this phase) ---------------------
# Server-only. Do not expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET with NEXT_PUBLIC_.
# Keep checkout disabled unless you are testing Stripe Checkout in test mode.
# Live mode / sk_live keys are intentionally blocked by the application.
STRIPE_ENVIRONMENT=test
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Required for Stripe Embedded Checkout in /dashboard/settings/billing.
# This is a publishable key only; never use NEXT_PUBLIC_ for Stripe secret keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -- Deprecated Asaas SaaS Billing ------------------------------------------
# Kept only for legacy local references/tests. The active SaaS checkout provider is Stripe.
ASAAS_ENVIRONMENT=sandbox
ASAAS_CHECKOUT_ENABLED=false
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ── Admin Script Credentials ──────────────────────────────────
# Only needed when running: npm run setup:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
